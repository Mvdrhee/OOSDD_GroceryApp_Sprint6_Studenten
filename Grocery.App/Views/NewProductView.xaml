<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Grocery.App.ViewModels"
             xmlns:m="clr-namespace:Grocery.Core.Models;assembly=Grocery.Core"
             x:Class="Grocery.App.Views.NewProductView"
             x:DataType="vm:NewProductViewModel"
             Title="NewProductView">
    <Shell.TitleView>
        <Grid>
            <Label Text="Product Toevoegen" FontSize="Large" HorizontalOptions="Center" VerticalOptions="Center" />
        </Grid>
    </Shell.TitleView>
	<StackLayout Padding="20" VerticalOptions="Center">
		<Entry Placeholder="Productnaam" Text="{Binding InputName}" />
		<Entry Placeholder="Voorraad" Text="{Binding InputStock}" Keyboard="Numeric" />
		<Entry Placeholder="Prijs" Text="{Binding InputPrice}" Keyboard="Numeric" />
		<Entry Placeholder="Houdbaarheidsdatum" Text="{Binding InputDate}" />
		<Button Text="Voeg toe" Command="{Binding AddProductCommand}" />
		<Label Text="{Binding ErrorMessage}" TextColor="Red" />
	</StackLayout>
</ContentPage>